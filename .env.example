# ── 服务 ──────────────────────────────────────────────
PORT=3013
API_KEY=dev-123123
DB_PATH=./agent-swarm.sqlite

# ── 心跳 ──────────────────────────────────────────────
HEARTBEAT_INTERVAL_MS=5000       # Worker 上报间隔
HEARTBEAT_TIMEOUT_MS=30000       # 超时判定阈值（建议 ≥ 4×间隔）
SWEEP_INTERVAL_MS=1000           # 服务端清扫频率

# ── Worker ────────────────────────────────────────────
MAX_ASSIGN_COUNT=3               # 单个任务最大认领次数（防死循环重派）
AGENT_CLI=claude                 # 调用的命令行 Agent
WORKER_POLL_INTERVAL_MS=3000     # Worker 空闲轮询间隔
API_BASE_URL=http://127.0.0.1:3013

# ── Embedding（可选；留空则用离线哈希向量降级）──────────
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 兼容 OpenAI 官方及 api.openai-proxy.org 等代理端点（不含 /v1 后缀）
EMBEDDING_BASE_URL=https://api.openai.com

# ── Lead ──────────────────────────────────────────────
LEAD_POLL_INTERVAL_MS=5000
