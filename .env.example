# ── 服务 ──────────────────────────────────────────────
PORT=3013
API_KEY=dev-123123
DB_PATH=./agent-swarm.sqlite

# ── 心跳 ──────────────────────────────────────────────
HEARTBEAT_INTERVAL_MS=5000       # Worker 上报间隔
HEARTBEAT_TIMEOUT_MS=30000       # 超时判定阈值（建议 ≥ 4×间隔）
SWEEP_INTERVAL_MS=1000           # 服务端清扫频率

# ── Worker ────────────────────────────────────────────
MAX_ASSIGN_COUNT=3               # 单个任务最大认领次数（防死循环重派）
AGENT_CLI=claude                 # 调用的命令行 Agent
WORKER_POLL_INTERVAL_MS=3000     # Worker 空闲轮询间隔
API_BASE_URL=http://127.0.0.1:3013

# ── Embedding（可选；留空则用离线哈希向量降级）──────────
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 兼容 OpenAI 官方及 api.openai-proxy.org 等代理端点（不含 /v1 后缀）
EMBEDDING_BASE_URL=https://api.openai.com

# ── Lead ──────────────────────────────────────────────
LEAD_POLL_INTERVAL_MS=5000

# ── 竞品情报（CI）─────────────────────────────────────

# 我方产品档案（Compare 评分 / Battlecard 的对比基线）
OUR_PRODUCT_NAME=
OUR_PRODUCT_WEBSITE=
OUR_PRODUCT_POSITIONING=
OUR_TARGET_MARKET=

# 每日监控 cron（server 启动时自动创建该 schedule）
CI_MONITOR_CRON=0 9 * * *
# Battlecard 质检门槛（1-10，低于则回 research 重搜）
CI_QUALITY_THRESHOLD=7
# Reflexion 质量循环最大回炉轮次
CI_MAX_REFLEXION_ROUNDS=2

# 告警邮件（SMTP）。465 用 SSL（SMTP_SECURE=true）；587 设 false 走 STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=                 # 逗号分隔收件人

# 搜索（SerpAPI 兼容；留空则用 demo 桩结果）
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
SEARCH_ENGINE=google

# Demo 模式：无任何 API key 也能跑通全链路（用确定性桩数据）
CI_DEMO_MODE=false

# ── MySQL 存储 ────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_swarm

# ── 模型 ──────────────────────────────────────────────
# 分析主阶段模型（claude CLI --model）
AGENT_MODEL=claude-opus-5
# 评审 agent 数量（多 agent 测评，默认 3）
CI_JUDGE_COUNT=3
# 评审用 DeepSeek API（OpenAI 兼容）。填 key 后 quality 阶段走真实 3 评审
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
