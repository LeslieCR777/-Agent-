{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["packages/contracts/src/*"],
      "@domain/*": ["packages/domain/src/*"],
      "@runtime/*": ["packages/agent-runtime/src/*"],
      "@platform/*": ["packages/platform/src/*"],
      "@ui/*": ["packages/ui-components/src/*"],
      "@api/*": ["apps/api/src/*"],
      "@orchestrator/*": ["apps/orchestrator/src/*"],
      "@worker/*": ["apps/worker/src/*"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx", "infrastructure/**/*.ts", "tests/**/*.ts"]
}
