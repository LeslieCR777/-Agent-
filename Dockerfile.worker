# Worker 镜像：内置 node + claude CLI，容器化隔离执行环境。
# 需要把宿主机上的 claude 凭证挂载进来（见 docker-compose.yml）。
FROM node:22-alpine

# claude CLI 需要身份凭证，官方支持 ANTHROPIC_API_KEY 或已登录的 ~/.claude
ENV ANTHROPIC_API_KEY=""

WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev

COPY src/ ./src/
COPY tsconfig.json ./

# 健康检查
HEALTHCHECK --interval=10s --timeout=3s \
  CMD wget -q -O /dev/null http://127.0.0.1:3013/api/health || exit 1

# 默认启动一个 worker
CMD ["npx", "tsx", "src/worker/index.ts", "--name", "worker-1"]
